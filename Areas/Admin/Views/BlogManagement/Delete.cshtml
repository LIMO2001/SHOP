@using LaptopStore.Models
@model BlogPost
@{
    ViewData["Title"] = "Delete Blog Post";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-danger">
            <i class="fas fa-trash me-2"></i>Delete Blog Post
        </h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="alert alert-warning">
                <h5 class="alert-heading">
                    <i class="fas fa-exclamation-triangle me-2"></i>Warning
                </h5>
                Are you sure you want to delete this blog post? This action cannot be undone.
            </div>

            <div class="row">
                <div class="col-md-8">
                    <h4>@Model.Title</h4>
                    <p class="text-muted">By @Model.Author on @Model.DatePosted.ToString("MMMM dd, yyyy")</p>
                    
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-3">
                            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Title" style="max-height: 200px;">
                        </div>
                    }
                    
                    <div class="content-preview border rounded p-3 bg-light">
                        @Html.Raw(Model.Content.Length > 500 ? Model.Content.Substring(0, 500) + "..." : Model.Content)
                    </div>
                </div>
                
                <div class="col-md-4">
                    <dl class="row">
                        <dt class="col-sm-4">Slug:</dt>
                        <dd class="col-sm-8">@Model.Slug</dd>
                        
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Draft</span>
                            }
                        </dd>
                        
                        <dt class="col-sm-4">Posted:</dt>
                        <dd class="col-sm-8">@Model.DatePosted.ToString("MMM dd, yyyy")</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <button type="submit" class="btn btn-danger me-2">
                        <i class="fas fa-trash me-1"></i>Delete Post
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>