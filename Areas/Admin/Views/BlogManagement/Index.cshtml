@using LaptopStore.Models
@model List<BlogPost>
@{
    ViewData["Title"] = "Blog Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-blog me-2"></i>Blog Management
        </h1>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i>Create New Post
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Date Posted</th>
                            <th>Published</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@post.Title</div>
                                    <small class="text-muted">/@post.Slug</small>
                                </td>
                                <td>@post.Author</td>
                                <td>@post.DatePosted.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (post.IsPublished)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">No</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = post.Id })" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = post.Id })" class="btn btn-danger btn-sm" 
                                       onclick="return confirm('Are you sure you want to delete this post?')">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>