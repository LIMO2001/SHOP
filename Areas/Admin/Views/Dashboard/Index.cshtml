@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
        </h1>
        <div class="btn-group">
            <a href="@Url.Action("Index", "ProductManagement", new { area = "Admin" })" class="btn btn-primary">
                <i class="fas fa-laptop me-1"></i>Manage Products
            </a>
            <a href="@Url.Action("Index", "CategoryManagement", new { area = "Admin" })" class="btn btn-success">
                <i class="fas fa-tags me-1"></i>Manage Categories
            </a>
            <a href="@Url.Action("Index", "BlogManagement", new { area = "Admin" })" class="btn btn-info">
                <i class="fas fa-blog me-1"></i>Manage Blog
            </a>
            <a href="@Url.Action("Index", "CareerManagement", new { area = "Admin" })" class="btn btn-warning">
                <i class="fas fa-briefcase me-1"></i>Manage Careers
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Products
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @ViewBag.TotalProducts
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-laptop fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Total Categories
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @ViewBag.TotalCategories
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tags fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Total Blog Posts
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @ViewBag.TotalBlogPosts
                            </div>
                            <div class="text-xs text-muted">
                                @ViewBag.PublishedBlogPosts Published
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-blog fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Total Careers
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @ViewBag.TotalCareers
                            </div>
                            <div class="text-xs text-muted">
                                @ViewBag.ActiveCareers Active
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-briefcase fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row Statistics Cards -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-secondary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">
                                Total Users
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @ViewBag.TotalUsers
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Total Orders
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @ViewBag.TotalOrders
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-shopping-cart fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Revenue -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Total Revenue
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                $@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00")
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low Stock Alert -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Low Stock Products
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @(ViewBag.LowStockProducts?.Count ?? 0)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Content Section -->
    <div class="row">
        <!-- Recent Blog Posts -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-blog me-2"></i>Recent Blog Posts
                    </h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentBlogPosts != null && ViewBag.RecentBlogPosts.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Author</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var post in ViewBag.RecentBlogPosts)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-truncate" style="max-width: 200px;" title="@post.Title">
                                                    @post.Title
                                                </div>
                                            </td>
                                            <td>@post.Author</td>
                                            <td>@post.DatePosted.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-@(post.IsPublished ? "success" : "warning")">
                                                    @(post.IsPublished ? "Published" : "Draft")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <a href="@Url.Action("Index", "BlogManagement", new { area = "Admin" })" class="btn btn-info btn-sm">
                                <i class="fas fa-blog me-1"></i>Manage Blog Posts
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-blog fa-2x mb-3"></i>
                            <p>No recent blog posts</p>
                            <a href="@Url.Action("Create", "BlogManagement", new { area = "Admin" })" class="btn btn-info btn-sm mt-2">
                                <i class="fas fa-plus me-1"></i>Create First Post
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Careers -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-briefcase me-2"></i>Recent Career Opportunities
                    </h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentCareers != null && ViewBag.RecentCareers.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Position</th>
                                        <th>Department</th>
                                        <th>Deadline</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var career in ViewBag.RecentCareers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@career.Title</div>
                                            </td>
                                            <td>@career.Department</td>
                                            <td>@career.ApplicationDeadline.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-@(career.IsActive ? "success" : "secondary")">
                                                    @(career.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <a href="@Url.Action("Index", "CareerManagement", new { area = "Admin" })" class="btn btn-warning btn-sm">
                                <i class="fas fa-briefcase me-1"></i>Manage Careers
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-briefcase fa-2x mb-3"></i>
                            <p>No recent career opportunities</p>
                            <a href="@Url.Action("Create", "CareerManagement", new { area = "Admin" })" class="btn btn-warning btn-sm mt-2">
                                <i class="fas fa-plus me-1"></i>Add Career Opportunity
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Create", "ProductManagement", new { area = "Admin" })" class="btn btn-primary btn-block h-100">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="fas fa-plus-circle fa-2x mb-2"></i>
                                    <span>Add New Product</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Create", "CategoryManagement", new { area = "Admin" })" class="btn btn-success btn-block h-100">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="fas fa-tags fa-2x mb-2"></i>
                                    <span>Add New Category</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Create", "BlogManagement", new { area = "Admin" })" class="btn btn-info btn-block h-100">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="fas fa-edit fa-2x mb-2"></i>
                                    <span>Write Blog Post</span>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="@Url.Action("Create", "CareerManagement", new { area = "Admin" })" class="btn btn-warning btn-block h-100">
                                <div class="d-flex flex-column align-items-center">
                                    <i class="fas fa-briefcase fa-2x mb-2"></i>
                                    <span>Add Career</span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "secondary",
            "processing" => "info", 
            "shipped" => "primary",
            "delivered" => "success",
            "completed" => "success",
            "cancelled" => "danger",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Dashboard loaded successfully');
        });
    </script>
}