@using LaptopStore.Models
@model Career
@{
    ViewData["Title"] = "Delete Career Opportunity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-danger">
            <i class="fas fa-trash me-2"></i>Delete Career Opportunity
        </h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="alert alert-warning">
                <h5 class="alert-heading">
                    <i class="fas fa-exclamation-triangle me-2"></i>Warning
                </h5>
                Are you sure you want to delete this career opportunity? This action cannot be undone.
            </div>

            <div class="row">
                <div class="col-md-8">
                    <h4>@Model.Title</h4>
                    <p class="text-muted">
                        <i class="fas fa-building me-2"></i>@Model.Department • 
                        <i class="fas fa-map-marker-alt me-2"></i>@Model.Location • 
                        <i class="fas fa-clock me-2"></i>@Model.EmploymentType
                    </p>
                    
                    <div class="mb-4">
                        <h6>Job Description:</h6>
                        <div class="border rounded p-3 bg-light">
                            @Model.Description
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6>Requirements:</h6>
                        <div class="border rounded p-3 bg-light">
                            @Model.Requirements
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <dl class="row">
                        <dt class="col-sm-5">Salary Range:</dt>
                        <dd class="col-sm-7">
                            @if (Model.SalaryRangeMin.HasValue && Model.SalaryRangeMax.HasValue)
                            {
                                <text>KSh @Model.SalaryRangeMin.Value.ToString("N0") - KSh @Model.SalaryRangeMax.Value.ToString("N0")</text>
                            }
                            else
                            {
                                <text>Not specified</text>
                            }
                        </dd>
                        
                        <dt class="col-sm-5">Date Posted:</dt>
                        <dd class="col-sm-7">@Model.DatePosted.ToString("MMM dd, yyyy")</dd>
                        
                        <dt class="col-sm-5">Deadline:</dt>
                        <dd class="col-sm-7">@Model.ApplicationDeadline.ToString("MMM dd, yyyy")</dd>
                        
                        <dt class="col-sm-5">Status:</dt>
                        <dd class="col-sm-7">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <button type="submit" class="btn btn-danger me-2">
                        <i class="fas fa-trash me-1"></i>Delete Career Opportunity
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>