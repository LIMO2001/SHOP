@model Career
@{
    ViewData["Title"] = Model.Title + " - Careers at DKL Empire";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- Back to Careers Link -->
            <div class="mb-4">
                <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Back to Careers
                </a>
            </div>

            <!-- Job Header -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h1 class="h2 fw-bold text-primary mb-3">@Model.Title</h1>
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                <span class="badge bg-primary">
                                    <i class="fas fa-building me-1"></i>@Model.Department
                                </span>
                                <span class="badge bg-success">
                                    <i class="fas fa-map-marker-alt me-1"></i>@Model.Location
                                </span>
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-clock me-1"></i>@Model.EmploymentType
                                </span>
                            </div>
                            @if (Model.SalaryRangeMin.HasValue && Model.SalaryRangeMax.HasValue)
                            {
                                <div class="mb-3">
                                    <span class="fw-bold text-success">
                                        <i class="fas fa-money-bill-wave me-1"></i>
                                        KSh @Model.SalaryRangeMin.Value.ToString("N0") - KSh @Model.SalaryRangeMax.Value.ToString("N0")
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="col-md-4 text-md-end">
                            <div class="mb-3">
                                <span class="text-muted d-block">Posted: @Model.DatePosted.ToString("MMM dd, yyyy")</span>
                                <span class="text-danger fw-bold d-block">
                                    <i class="fas fa-calendar-times me-1"></i>
                                    Apply by: @Model.ApplicationDeadline.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                            <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#applyModal">
                                <i class="fas fa-paper-plane me-1"></i>Apply Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Job Details -->
            <div class="row">
                <!-- Main Content -->
                <div class="col-lg-8">
                    <!-- Job Description -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-file-alt me-2 text-primary"></i>Job Description
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="job-content">
                                @Html.Raw(Model.Description.Replace("\n", "<br>"))
                            </div>
                        </div>
                    </div>

                    <!-- Requirements -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-tasks me-2 text-success"></i>Requirements & Qualifications
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="requirements-content">
                                @Html.Raw(Model.Requirements.Replace("\n", "<br>"))
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4">
                    <!-- Quick Facts -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h6 class="card-title mb-0">
                                <i class="fas fa-info-circle me-2 text-info"></i>Job Details
                            </h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Position:</dt>
                                <dd class="col-sm-7">@Model.Title</dd>

                                <dt class="col-sm-5">Department:</dt>
                                <dd class="col-sm-7">@Model.Department</dd>

                                <dt class="col-sm-5">Location:</dt>
                                <dd class="col-sm-7">@Model.Location</dd>

                                <dt class="col-sm-5">Type:</dt>
                                <dd class="col-sm-7">@Model.EmploymentType</dd>

                                <dt class="col-sm-5">Posted:</dt>
                                <dd class="col-sm-7">@Model.DatePosted.ToString("MMM dd, yyyy")</dd>

                                <dt class="col-sm-5">Deadline:</dt>
                                <dd class="col-sm-7 text-danger fw-bold">@Model.ApplicationDeadline.ToString("MMM dd, yyyy")</dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Share This Job -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="card-title mb-0">
                                <i class="fas fa-share-alt me-2 text-warning"></i>Share This Job
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <div class="btn-group" role="group">
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="fab fa-linkedin"></i>
                                </a>
                                <a href="#" class="btn btn-outline-info btn-sm">
                                    <i class="fab fa-twitter"></i>
                                </a>
                                <a href="#" class="btn btn-outline-primary btn-sm">
                                    <i class="fab fa-facebook"></i>
                                </a>
                                <a href="#" class="btn btn-outline-success btn-sm">
                                    <i class="fab fa-whatsapp"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Call to Action -->
            <div class="card bg-primary text-white mt-4">
                <div class="card-body text-center py-4">
                    <h4 class="card-title mb-3">Ready to Join Our Team?</h4>
                    <p class="card-text mb-4">Take the next step in your career journey with DKL Empire</p>
                    <button class="btn btn-light btn-lg" data-bs-toggle="modal" data-bs-target="#applyModal">
                        <i class="fas fa-paper-plane me-1"></i>Apply for This Position
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Application Modal -->
<div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="applyModalLabel">
                    <i class="fas fa-paper-plane me-2"></i>Apply for @Model.Title
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="applicationForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="firstName" class="form-label">First Name *</label>
                            <input type="text" class="form-control" id="firstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="lastName" class="form-label">Last Name *</label>
                            <input type="text" class="form-control" id="lastName" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label">Email Address *</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Phone Number *</label>
                            <input type="tel" class="form-control" id="phone" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="coverLetter" class="form-label">Cover Letter *</label>
                        <textarea class="form-control" id="coverLetter" rows="4" placeholder="Tell us why you're interested in this position..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="resume" class="form-label">Upload Resume/CV *</label>
                        <input type="file" class="form-control" id="resume" accept=".pdf,.doc,.docx" required>
                        <div class="form-text">Accepted formats: PDF, DOC, DOCX (Max: 5MB)</div>
                    </div>
                    <div class="mb-3">
                        <label for="portfolio" class="form-label">Portfolio Link (Optional)</label>
                        <input type="url" class="form-control" id="portfolio" placeholder="https://">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitApplication()">
                    <i class="fas fa-paper-plane me-1"></i>Submit Application
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .job-content, .requirements-content {
            line-height: 1.6;
        }

        .badge {
            font-size: 0.85rem;
            padding: 0.5em 0.8em;
        }

        .card-header {
            border-bottom: 2px solid #e9ecef;
        }

        dl.row dt {
            font-weight: 600;
            color: #6c757d;
        }

        dl.row dd {
            color: #495057;
        }
    </style>
}

@section Scripts {
    <script>
        function submitApplication() {
            const form = document.getElementById('applicationForm');
            if (form.checkValidity()) {
                // Here you would typically send the application to your server
                alert('Application submitted successfully! We will review your application and get back to you soon.');
                $('#applyModal').modal('hide');
                form.reset();
            } else {
                form.reportValidity();
            }
        }

        // Update days remaining
        document.addEventListener('DOMContentLoaded', function() {
            const deadline = new Date('@Model.ApplicationDeadline.ToString("yyyy-MM-dd")');
            const today = new Date();
            const timeDiff = deadline - today;
            const daysRemaining = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));
            
            if (daysRemaining >= 0) {
                const daysText = daysRemaining === 1 ? 'day' : 'days';
                // You can display this information if needed
                console.log(`Application deadline in ${daysRemaining} ${daysText}`);
            }
        });
    </script>
}