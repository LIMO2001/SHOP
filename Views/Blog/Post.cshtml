@model BlogPost
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <article>
                <h1>@Model.Title</h1>
                <p class="text-muted">
                    Posted by @Model.Author on @Model.DatePosted.ToString("MMMM dd, yyyy")
                </p>
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid mb-4" alt="@Model.Title">
                }
                
                <div class="blog-content">
                    @Html.Raw(Model.Content)
                </div>
            </article>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Recent Posts</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentPosts != null)
                    {
                        <ul class="list-unstyled">
                            @foreach (var post in ViewBag.RecentPosts)
                            {
                                <li class="mb-2">
                                    <a href="@Url.Action("Post", "Blog", new { slug = post.Slug })" class="text-decoration-none">
                                        @post.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>