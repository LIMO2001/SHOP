@{
    ViewData["Title"] = "Warranty Information";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <h1 class="text-center mb-4">Warranty Information</h1>
            
            <div class="card shadow">
                <div class="card-body p-5">
                    <h4>Standard Warranty Coverage</h4>
                    <p>All our laptops come with a comprehensive warranty package:</p>
                    
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5><i class="fas fa-laptop-medical text-primary me-2"></i>Hardware Warranty</h5>
                                    <p class="mb-0">1-3 years depending on manufacturer</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5><i class="fas fa-headset text-success me-2"></i>Technical Support</h5>
                                    <p class="mb-0">1 year free technical support</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h4 class="mt-5">Warranty Claims Process</h4>
                    <ol>
                        <li>Contact our support team with your issue</li>
                        <li>Provide proof of purchase and serial number</li>
                        <li>We'll diagnose the issue remotely if possible</li>
                        <li>If repair is needed, we'll arrange pickup or service center visit</li>
                        <li>Most repairs completed within 3-5 business days</li>
                    </ol>

                    <div class="alert alert-warning mt-4">
                        <h5><i class="fas fa-exclamation-triangle me-2"></i>Warranty Exclusions</h5>
                        <p class="mb-0">Physical damage, liquid spills, unauthorized modifications, and normal wear and tear are not covered by warranty.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>