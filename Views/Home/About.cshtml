@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <h1 class="text-center mb-4">About DKL Empire</h1>
            
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h3>Your Trusted Laptop Partner</h3>
                            <p>DKL Empire has been providing high-quality laptops and computing solutions to customers across Kenya since 2020. We specialize in gaming laptops, business workstations, and student-friendly devices.</p>
                            <p>Our mission is to make cutting-edge technology accessible to everyone while providing exceptional customer service and technical support.</p>
                        </div>
                        <div class="col-md-6 text-center">
                            <img src="~/images/logo.png" alt="DKL Empire" class="img-fluid rounded" style="max-height: 200px;">
                        </div>
                    </div>

                    <div class="row mt-5">
                        <div class="col-md-4 text-center">
                            <i class="fas fa-award fa-3x text-primary mb-3"></i>
                            <h5>Quality Products</h5>
                            <p class="text-muted">Only genuine products from trusted manufacturers</p>
                        </div>
                        <div class="col-md-4 text-center">
                            <i class="fas fa-headset fa-3x text-success mb-3"></i>
                            <h5>Expert Support</h5>
                            <p class="text-muted">Dedicated technical support team</p>
                        </div>
                        <div class="col-md-4 text-center">
                            <i class="fas fa-shipping-fast fa-3x text-warning mb-3"></i>
                            <h5>Fast Delivery</h5>
                            <p class="text-muted">Nationwide delivery within 3-5 days</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>