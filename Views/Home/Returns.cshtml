@{
    ViewData["Title"] = "Returns & Refunds";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <h1 class="text-center mb-4">Returns & Refunds Policy</h1>
            
            <div class="card shadow">
                <div class="card-body p-5">
                    <h4>30-Day Return Policy</h4>
                    <p>We offer a 30-day return policy for all products in original condition with all accessories included.</p>

                    <h4 class="mt-5">Return Process</h4>
                    <ol>
                        <li>Contact our support team to initiate return</li>
                        <li>Receive return authorization and shipping label</li>
                        <li>Package item securely with all original contents</li>
                        <li>Drop off at designated shipping location</li>
                        <li>Receive refund once item is inspected</li>
                    </ol>

                    <h4 class="mt-5">Refund Timeline</h4>
                    <ul>
                        <li>Credit Card Refunds: 5-7 business days</li>
                        <li>Mobile Money Refunds: 24-48 hours</li>
                        <li>Bank Transfer Refunds: 3-5 business days</li>
                    </ul>

                    <div class="alert alert-info mt-4">
                        <h5><i class="fas fa-info-circle me-2"></i>Important Notes</h5>
                        <p class="mb-0">Software licenses and opened software products are not eligible for return. Custom configured systems may have different return policies.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>