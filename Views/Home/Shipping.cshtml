@{
    ViewData["Title"] = "Shipping Information";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <h1 class="text-center mb-4">Shipping Information</h1>
            
            <div class="card shadow">
                <div class="card-body p-5">
                    <h4>Delivery Options</h4>
                    <div class="row mt-4">
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
                                <h5>Standard Shipping</h5>
                                <p class="text-muted">3-5 business days</p>
                                <p class="fw-bold">KSh 500</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="fas fa-rocket fa-3x text-warning mb-3"></i>
                                <h5>Express Shipping</h5>
                                <p class="text-muted">1-2 business days</p>
                                <p class="fw-bold">KSh 1,000</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <i class="fas fa-store fa-3x text-success mb-3"></i>
                                <h5>Store Pickup</h5>
                                <p class="text-muted">Same day available</p>
                                <p class="fw-bold">Free</p>
                            </div>
                        </div>
                    </div>

                    <h4 class="mt-5">Shipping Areas</h4>
                    <ul>
                        <li>Nairobi: 1-2 business days</li>
                        <li>Major Cities: 2-3 business days</li>
                        <li>Other Regions: 3-5 business days</li>
                    </ul>

                    <h4 class="mt-5">Tracking Your Order</h4>
                    <p>Once your order ships, you'll receive a tracking number via email to monitor your delivery.</p>
                </div>
            </div>
        </div>
    </div>
</div>