@using LaptopStore.Models
@model List<Product>
@{
    ViewData["Title"] = "Welcome to LaptopStore";
}

<!-- 🔹 Hero Section -->
<div class="hero-section bg-primary text-white py-5 mb-5">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">Welcome to LaptopStore</h1>
        <p class="lead">Find the perfect laptop for work, school, or gaming</p>

        < Search Bar -->
        <form asp-action="Search" asp-controller="Store" method="get" class="d-flex justify-content-center mt-4">
            <input type="text" name="query" class="form-control w-50 me-2" placeholder="Search laptops..." required />
            <button type="submit" class="btn btn-light">
                <i class="fas fa-search me-1"></i> Search
            </button>
        </form>
    </div>
</div>

<!-- 🔹 Featured Laptops Section -->
<div class="container">
    <h2 class="mb-4 fw-semibold">Featured Laptops</h2>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var product in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 product-card shadow-sm border-0">
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text flex-grow-1 small text-muted">
                                <i class="fas fa-microchip me-1"></i>@product.Processor<br>
                                <i class="fas fa-memory me-1"></i>@product.RAM<br>
                                <i class="fas fa-hdd me-1"></i>@product.Storage
                            </p>

                            <div class="mt-auto">
                                <p class="h5 text-primary mb-2">$@product.Price.ToString("N2")</p>

                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("ProductDetails", "Store", new { id = product.Id })" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i> View Details
                                    </a>

                                    @if (product.StockQuantity > 0)
                                    {
                                        <button class="btn btn-primary btn-sm add-to-cart"
                                                data-product-id="@product.Id"
                                                data-product-name="@product.Name">
                                            <i class="fas fa-cart-plus me-1"></i> Add to Cart
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" disabled>
                                            <i class="fas fa-bell me-1"></i> Out of Stock
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted">
                <i class="fas fa-laptop fa-3x mb-3"></i>
                <h5>No featured laptops available at the moment.</h5>
            </div>
        }
    </div>
</div>

<!-- 🔹 Toast Notification Script -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.add-to-cart').forEach(button => {
                button.addEventListener('click', async function () {
                    const productId = this.dataset.productId;
                    const productName = this.dataset.productName;
                    const btn = this;

                    const originalText = btn.innerHTML;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Adding...';
                    btn.disabled = true;

                    try {
                        const response = await fetch('/Cart/AddToCart?productId=' + productId + '&quantity=1', {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                            }
                        });

                        if (response.ok) {
                            const result = await response.json();
                            if (result.success) {
                                $('#cartCount').text(result.cartCount);
                                showToast('Success', productName + ' added to cart!', 'success');
                                btn.innerHTML = '<i class="fas fa-check me-1"></i>Added!';
                            } else {
                                showToast('Error', 'Failed to add product.', 'danger');
                                btn.innerHTML = originalText;
                            }
                        } else {
                            showToast('Error', 'Request failed.', 'danger');
                            btn.innerHTML = originalText;
                        }
                    } catch (error) {
                        console.error('Error adding to cart:', error);
                        showToast('Error', 'Unexpected error occurred.', 'danger');
                        btn.innerHTML = originalText;
                    } finally {
                        setTimeout(() => {
                            btn.innerHTML = originalText;
                            btn.disabled = false;
                        }, 2000);
                    }
                });
            });
        });

        // Bootstrap Toast
        function showToast(title, message, type) {
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 1050; min-width: 300px;';
            toast.innerHTML = `
                <strong>${title}</strong> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
}
